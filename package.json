{
  "name": "open-overlay",
  "version": "1.2.11",
  "description": "OpenRailwayMap vector overlay for Subway Builder, streamed through a local proxy",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:converter && vite build",
    "dev:link": "tsx scripts/link.ts",
    "dev:unlink": "tsx scripts/link.ts --unlink",
    "proxy": "node proxy.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:converter": "esbuild converter/mlt-convert.src.js --bundle --platform=node --format=esm --target=node18 --outfile=mlt-convert.js --log-level=warning --legal-comments=inline"
  },
  "keywords": [
    "subway-builder",
    "mod",
    "openrailwaymap"
  ],
  "author": "YellowAquarium",
  "license": "MIT",
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@maplibre/mlt": "^1.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.9",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^5.18.0",
    "pbf": "^4.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vt-pbf": "^3.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YellowAquarium/open-overlay.git"
  }
}
