{
  "name": "open-overlay",
  "version": "1.0.0",
  "description": "OpenRailwayMap vector overlay for Subway Builder, streamed through a local proxy",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev:link": "tsx scripts/link.ts",
    "dev:unlink": "tsx scripts/link.ts --unlink",
    "proxy": "node proxy.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "subway-builder",
    "mod",
    "openrailwaymap"
  ],
  "author": "YellowAquarium",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.9",
    "maplibre-gl": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vite-plugin-static-copy": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YellowAquarium/open-overlay.git"
  }
}
